# Backend reachable from the emulator. Physical device: use your LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4001
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Static captcha page on your existing HTTPS hosting (required for protected Reader).
EXPO_PUBLIC_CAPTCHA_URL=
# Enable only after the push-device API and Android Firebase config are ready.
EXPO_PUBLIC_PUSH_ENABLED=false
# Existing EAS project UUID used by Expo Push Service (not a server secret).
EXPO_PUBLIC_EAS_PROJECT_ID=
# Build-time path to Firebase Android client config (package com.mangadock.mobile).
# Never set this to a service-account private key.
GOOGLE_SERVICES_JSON=
